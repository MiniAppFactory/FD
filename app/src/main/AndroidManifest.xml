<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Oyun tamamen OFFLINE oynanir. INTERNET ve ACCESS_NETWORK_STATE izinlerini bu dosya
         artik BILDIRMEZ (yalnizca reklam ve riza SDK'lari icindi; 2026-09-30'da kaldirildi).
         Birlesik manifest'te bu ikisi yine gorunur: Play Billing kutuphanesi
         (billing-ktx 8.0.0 -> datatransport `transport-backend-cct`) kendi telemetrisi icin
         ekler. Oynanista kullanilmazlar; Data Safety/gizlilik taslaklari BIRLESIK manifest'e
         gore yazilir (bkz. store/listing). Play Billing izni (com.android.vending.BILLING)
         de kutuphanenin manifest'inden gelir. -->

    <!-- Haptik geri bildirim (game/audio/HapticsManager.kt).

         BURADA OLMASININ SEBEBI: HapticsManager main kaynak agacinda
         Vibrator.vibrate/cancel cagiriyor ve izin bildirilmedigi icin
         lintDebug MissingPermission ile HATA veriyordu (build kapisi).
         Manifest bu is bolumunde ayarlar/inset koluna atanmisti, bu yuzden
         satiri o kol ekledi; haptik davranisinin kendisine dokunulmadi.

         Izin sinifi: NORMAL. Calisma zamaninda kullanicidan istenmez ve Play
         Data Safety formunda veri toplama olarak bildirilmez; cihazda titresim
         disinda hicbir yetenek acmaz. Haptik tamamen kaldirilirsa bu satir da
         kaldirilmalidir (kullanilmayan izin birakilmaz). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrontlineDefender">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.FrontlineDefender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
